# ── Hacker-themed functions ───────────────────────────
# Matrix-style text rain (optional terminal effect)
matrix() {
    echo -e "\033[1;32m"
    tr -c "[:digit:]" " " < /dev/urandom | dd cbs=$COLUMNS conv=unblock 2>/dev/null | TERM=linux head -c $((COLUMNS * LINES))
    echo -e "\033[0m"
}

# System status display
status() {
    echo -e "\033[1;36m▓▓▓ SYSTEM STATUS ▓▓▓\033[0m"
    echo -e "\033[0;36m▸ Uptime:\033[0m $(uptime -p | sed 's/up //')"
    echo -e "\033[0;36m▸ Load:\033[0m $(cat /proc/loadavg | awk '{print $1, $2, $3}')"
    echo -e "\033[0;36m▸ Memory:\033[0m $(free -h | grep '^Mem' | awk '{print $3 " / " $2}')"
    echo -e "\033[0;36m▸ Storage:\033[0m $(df -h / | tail -1 | awk '{print $3 " / " $2}')"
    echo -e "\033[0;36m▸ Timezone:\033[0m $(date +%Z)"
    echo ""
}

