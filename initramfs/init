#!/bin/sh
# =============================================================================
# frOSt initramfs /init - Shell Bootstrap
# =============================================================================
# Boot chain: asm early_init -> THIS -> compiled Python frost_init
#
# This shell bootstrap handles tasks that require no Python:
#   1. Run asm early_init (mount /proc, /sys, /dev, tmpfs)
#   2. Load kernel modules in dependency order
#   3. Populate devices (mdev, uevents, manual node creation)
#   4. Find and mount the squashfs root (making Python available)
#   5. Hand off to compiled Python frost_init via squashfs linker
#
# The Python init handles:
#   - OverlayFS setup, persistence, USB watchdog, switch_root
# =============================================================================

set +e
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

# ── ANSI colors ──
C_CYAN='\033[1;36m'
C_GREEN='\033[1;32m'
C_RED='\033[1;31m'
C_DIM='\033[0;37m'
C_WHITE='\033[1;37m'
C_BLUE='\033[1;34m'
C_RESET='\033[0m'

log()  { echo "${C_DIM}[frOSt]${C_RESET} $1"; }
ok()   { echo "${C_GREEN}[frOSt]${C_RESET} $1"; }
warn() { echo "${C_RED}[frOSt] WARNING:${C_RESET} $1"; }

# =============================================================================
# Step 1: Assembly early hardware init
# =============================================================================
if [ -x /early_init ]; then
    /early_init
    rc=$?
    if [ $rc -ne 0 ]; then
        warn "early_init failed (code $rc), using shell fallback"
        mkdir -p /proc /sys /dev
        mount -t proc proc /proc 2>/dev/null || true
        mount -t sysfs sysfs /sys 2>/dev/null || true
        mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
        mkdir -p /frost/lower /frost/upper /frost/work /frost/merged /frost/persist /frost/probe
        tmpfs_sz="512M"
        if [ -f /proc/meminfo ]; then
            mem_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
            if [ -n "$mem_kb" ] && [ "$mem_kb" -gt 0 ] 2>/dev/null; then
                half_mb=$((mem_kb / 2 / 1024))
                [ "$half_mb" -lt 512 ] && half_mb=512
                tmpfs_sz="${half_mb}M"
            fi
        fi
        mount -t tmpfs -o "size=${tmpfs_sz}" tmpfs /frost/upper
    fi
else
    warn "/early_init not found, using shell fallback"
    mkdir -p /proc /sys /dev
    mount -t proc proc /proc
    mount -t sysfs sysfs /sys
    mount -t devtmpfs devtmpfs /dev
    mkdir -p /frost/lower /frost/upper /frost/work /frost/merged /frost/persist /frost/probe
    mount -t tmpfs -o size=512M tmpfs /frost/upper
fi

# =============================================================================
# Step 2: Load kernel modules
# =============================================================================
log "Loading kernel modules..."
KVER=$(uname -r)
MODDIR="/lib/modules/${KVER}"

load_mod() {
    local mod="$1"
    modprobe "$mod" 2>/dev/null && return 0
    local ko=$(find "${MODDIR}" -name "${mod}.ko*" -o -name "$(echo "$mod" | tr '-' '_').ko*" 2>/dev/null | head -1)
    [ -n "$ko" ] && [ -f "$ko" ] && insmod "$ko" 2>/dev/null && return 0
    return 1
}

for mod in scsi_common scsi_mod t10-pi crct10dif_common crct10dif_generic crc-t10dif crc32c_generic crc64_rocksoft sd_mod sg \
           libata ata_piix ata_generic ahci libahci \
           virtio virtio_ring virtio_pci virtio_pci_modern_dev virtio_pci_legacy_dev \
           virtio_blk virtio_scsi virtio_net \
           usb-common usbcore xhci-hcd xhci-pci ehci-hcd ehci-pci usb-storage \
           overlay squashfs loop jbd2 mbcache crc16 ext4 crc32c_generic \
           vfat fat nls_cp437 nls_utf8 nls_ascii \
           hid usbhid hid-generic \
           drm drm_kms_helper bochs-drm virtio-gpu simpledrm; do
    load_mod "$mod" || true
done
ok "Modules loaded (kernel ${KVER})"

# =============================================================================
# Step 3: Device population
# =============================================================================
log "Populating devices..."
echo /bin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
mdev -s 2>/dev/null || true

# Retrigger uevents for USB/SCSI/PCI
if [ -d /sys/bus ]; then
    for uevent in /sys/bus/usb/devices/*/uevent /sys/bus/scsi/devices/*/uevent /sys/bus/pci/devices/*/uevent; do
        [ -f "$uevent" ] && echo "add" > "$uevent" 2>/dev/null || true
    done
fi
log "Waiting for USB enumeration..."
sleep 3
mdev -s 2>/dev/null || true

# Ensure all block device nodes exist
ensure_dev_nodes() {
    for sysblk in /sys/block/*; do
        bname=$(basename "$sysblk")
        case "$bname" in loop*|ram*) continue ;; esac
        majmin=$(cat "$sysblk/dev" 2>/dev/null) || continue
        maj="${majmin%%:*}"; min="${majmin##*:}"
        [ -b "/dev/$bname" ] || mknod "/dev/$bname" b "$maj" "$min" 2>/dev/null || true
        for part in "$sysblk/$bname"*/dev; do
            [ -f "$part" ] || continue
            pname=$(basename "$(dirname "$part")")
            pmajmin=$(cat "$part" 2>/dev/null) || continue
            pmaj="${pmajmin%%:*}"; pmin="${pmajmin##*:}"
            [ -b "/dev/$pname" ] || mknod "/dev/$pname" b "$pmaj" "$pmin" 2>/dev/null || true
        done
    done
}
ensure_dev_nodes

# =============================================================================
# Step 4: Find frOSt root partition
# =============================================================================
log "Searching for frOSt partitions..."
ROOT_DEV=""
PERSIST_DEV=""
TRIES=0
MAX_TRIES=30

while [ $TRIES -lt $MAX_TRIES ]; do
    mdev -s 2>/dev/null || true
    ensure_dev_nodes

    if [ $((TRIES % 5)) -eq 0 ]; then
        blocks=$(ls /sys/block/ 2>/dev/null | grep -v 'loop\|ram' | tr '\n' ' ')
        log "Scan $TRIES/$MAX_TRIES - blocks: $blocks"
    fi

    # Method 1: findfs
    ROOT_DEV=$(findfs LABEL=FROST_ROOT 2>/dev/null) || true
    if [ -n "$ROOT_DEV" ]; then
        ok "Found FROST_ROOT: $ROOT_DEV (findfs)"
        PERSIST_DEV=$(findfs LABEL=FROST_PERSIST 2>/dev/null) || true
        break
    fi

    # Method 2: by-label
    if [ -e /dev/disk/by-label/FROST_ROOT ]; then
        ROOT_DEV=$(readlink -f /dev/disk/by-label/FROST_ROOT)
        ok "Found FROST_ROOT: $ROOT_DEV (by-label)"
        [ -e /dev/disk/by-label/FROST_PERSIST ] && PERSIST_DEV=$(readlink -f /dev/disk/by-label/FROST_PERSIST)
        break
    fi

    # Method 3: probe
    for sysblk in /sys/block/sd* /sys/block/vd* /sys/block/hd* /sys/block/mmcblk* /sys/block/nvme*; do
        [ -d "$sysblk" ] || continue
        bname=$(basename "$sysblk")
        p2dev=""
        case "$bname" in
            sd*|vd*|hd*) p2dev="/dev/${bname}2" ;;
            mmcblk*|nvme*) p2dev="/dev/${bname}p2" ;;
        esac
        if [ -b "$p2dev" ]; then
            mkdir -p /frost/probe
            if mount -o ro "$p2dev" /frost/probe 2>/dev/null; then
                if [ -f /frost/probe/rootfs.squashfs ]; then
                    umount /frost/probe
                    ROOT_DEV="$p2dev"
                    case "$bname" in
                        sd*|vd*|hd*) PERSIST_DEV="/dev/${bname}3" ;;
                        mmcblk*|nvme*) PERSIST_DEV="/dev/${bname}p3" ;;
                    esac
                    ok "Found FROST_ROOT: $ROOT_DEV (probe)"
                    break 2
                fi
                umount /frost/probe
            fi
        fi
    done

    TRIES=$((TRIES + 1))
    sleep 1
done

if [ -z "$ROOT_DEV" ]; then
    echo ""
    echo "${C_RED}[frOSt] ============================================${C_RESET}"
    echo "${C_RED}[frOSt] FATAL: No frOSt device found!${C_RESET}"
    echo "${C_RED}[frOSt] ============================================${C_RESET}"
    echo ""
    echo "[frOSt] /proc/partitions:"
    cat /proc/partitions 2>/dev/null
    echo ""
    echo "[frOSt] Loaded modules:"
    cat /proc/modules 2>/dev/null | awk '{print "  "$1}' | head -30
    echo ""
    dmesg 2>/dev/null | grep -iE "usb|scsi|sd[a-z]|error|fail" | tail -30
    echo "[frOSt] Dropping to emergency shell..."
    exec /bin/sh
fi

# =============================================================================
# Step 5: Mount squashfs
# =============================================================================
log "Mounting root filesystem..."
TMP_MNT="/frost/tmp_root"
mkdir -p "$TMP_MNT"

mounted_squashfs=0
# Try direct squashfs mount
if mount -t squashfs -o ro "$ROOT_DEV" /frost/lower 2>/dev/null; then
    ok "Mounted squashfs directly"
    mounted_squashfs=1
else
    # Try ext4 containing rootfs.squashfs
    if mount -o ro "$ROOT_DEV" "$TMP_MNT" 2>/dev/null; then
        if [ -f "$TMP_MNT/rootfs.squashfs" ]; then
            mount -t squashfs -o ro,loop "$TMP_MNT/rootfs.squashfs" /frost/lower
            ok "Mounted squashfs from rootfs.squashfs"
            mounted_squashfs=1
        else
            umount "$TMP_MNT"
            mount -o ro "$ROOT_DEV" /frost/lower
            ok "Mounted ext4 root directly"
            mounted_squashfs=1
        fi
    fi
fi

if [ $mounted_squashfs -eq 0 ]; then
    echo "${C_RED}[frOSt] FATAL: Cannot mount root${C_RESET}"
    exec /bin/sh
fi

# =============================================================================
# Step 6: Hand off to Python init
# =============================================================================
# Now that squashfs is mounted, Python is available at /frost/lower/usr/bin/python3
# We invoke it via the squashfs dynamic linker because the ELF interpreter path
# in the Python binary doesn't exist in the initramfs.
log "Handing off to Python init..."

PYBIN="/frost/lower/usr/bin/python3"
PY_INIT="/frost_init.py"

# Find the dynamic linker in the squashfs
LD_LINUX=""
for ld in /frost/lower/lib64/ld-linux-x86-64.so.2 \
          /frost/lower/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 \
          /frost/lower/lib/ld-linux-x86-64.so.2; do
    if [ -f "$ld" ]; then
        LD_LINUX="$ld"
        break
    fi
done

python_ok=0
if [ -n "$LD_LINUX" ] && [ -f "$PYBIN" ] && [ -f "$PY_INIT" ]; then
    # Set up library paths so Python can find its libs from the squashfs
    export LD_LIBRARY_PATH="/frost/lower/usr/lib/x86_64-linux-gnu:/frost/lower/lib/x86_64-linux-gnu:/frost/lower/lib64"
    export PYTHONHOME="/frost/lower/usr"
    export PYTHONDONTWRITEBYTECODE=1

    # Pass device info to Python via environment
    export FROST_ROOT_DEV="$ROOT_DEV"
    export FROST_PERSIST_DEV="$PERSIST_DEV"

    ok "Linker: $LD_LINUX"
    log "Running: $LD_LINUX $PYBIN $PY_INIT"

    # Run Python init - if it succeeds it will exec switch_root and never return
    "$LD_LINUX" "$PYBIN" "$PY_INIT" "$@"
    pyrc=$?
    # If we get here, Python init failed to exec switch_root
    warn "Python init exited with code $pyrc"
else
    if [ -z "$LD_LINUX" ]; then
        warn "Dynamic linker not found in squashfs"
    fi
    if [ ! -f "$PYBIN" ]; then
        warn "Python not found at $PYBIN"
    fi
    if [ ! -f "$PY_INIT" ]; then
        warn "frost_init.py not found at $PY_INIT"
    fi
fi

# =============================================================================
# Shell fallback: overlay + basic persistence + switch_root
# =============================================================================
warn "Using shell fallback for boot completion"

# Check if overlay is already set up by Python (it might have set up overlay but failed at switch_root)
if mountpoint -q /frost/merged 2>/dev/null; then
    ok "Overlay already mounted (from Python init)"
else
    log "Setting up overlay filesystem..."
    mkdir -p /frost/upper/upper /frost/upper/work
    mount -t overlay overlay \
        -o "lowerdir=/frost/lower,upperdir=/frost/upper/upper,workdir=/frost/upper/work" \
        /frost/merged || { echo "${C_RED}[frOSt] FATAL: overlayfs failed${C_RESET}"; exec /bin/sh; }
    ok "Overlay mounted (shell fallback)"

    # Basic persistence
    if [ -n "$PERSIST_DEV" ] && [ -b "$PERSIST_DEV" ]; then
        if ! mountpoint -q /frost/persist 2>/dev/null; then
            mount -o rw "$PERSIST_DEV" /frost/persist 2>/dev/null && mkdir -p /frost/persist/data
        fi
    fi
fi

# Ensure virtual filesystems are mounted
mkdir -p /frost/merged/proc /frost/merged/sys /frost/merged/dev /frost/merged/run /frost/merged/tmp
mountpoint -q /frost/merged/proc 2>/dev/null || mount -t proc proc /frost/merged/proc 2>/dev/null || true
mountpoint -q /frost/merged/sys 2>/dev/null || mount -t sysfs sysfs /frost/merged/sys 2>/dev/null || true
mountpoint -q /frost/merged/dev 2>/dev/null || mount -t devtmpfs devtmpfs /frost/merged/dev 2>/dev/null || true
mountpoint -q /frost/merged/run 2>/dev/null || mount -t tmpfs tmpfs /frost/merged/run 2>/dev/null || true
mountpoint -q /frost/merged/tmp 2>/dev/null || mount -t tmpfs tmpfs /frost/merged/tmp 2>/dev/null || true

# Verify /sbin/init exists
if [ ! -f /frost/merged/sbin/init ] && [ ! -L /frost/merged/sbin/init ]; then
    echo "${C_RED}[frOSt] FATAL: /sbin/init not found in merged root${C_RESET}"
    echo "[frOSt] Contents of /frost/merged/sbin/:"
    ls -la /frost/merged/sbin/ 2>/dev/null | head -20
    echo "[frOSt] Dropping to emergency shell..."
    exec /bin/sh
fi

ok "Boot complete - switching to merged root"
exec switch_root /frost/merged /sbin/init "$@"
